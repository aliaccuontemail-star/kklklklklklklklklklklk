<?xml version="1.0" encoding="utf-8"?>
<!-- Release must use HTTPS only. Debug has an overriding resource that permits local HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
