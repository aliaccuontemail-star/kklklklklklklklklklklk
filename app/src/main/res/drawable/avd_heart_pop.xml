<?xml version="1.0" encoding="utf-8"?>
<!-- Start: grey heart. End: red heart. Going to the end squashes, then springs past full size. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_fx_heart">
    <target android:name="heart" android:animation="@animator/fx_fill_to_red" />
    <target android:name="pop" android:animation="@animator/fx_pop_scale_x" />
</animated-vector>
